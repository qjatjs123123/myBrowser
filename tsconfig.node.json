{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "composite": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"], "@main/*": ["src/main/*"] }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "e2e/**/*",
    "e2e-packaged/**/*",
    "scripts/**/*",
    "eval/**/*",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "vitest.setup.main.ts",
    "playwright.config.ts",
    "playwright.eval.config.ts",
    "playwright.packaged.config.ts"
  ]
}
