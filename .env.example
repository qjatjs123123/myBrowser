# 복사해서 .env 로 쓴다. Claude 는 .env 를 읽거나 고칠 수 없다.
# 모델 프로필 (필수, spec 007) — dev: 사내 GenAI 프록시 / prod: Claude API 비즈니스(게이트웨이 + 구독). 설치판은 항상 prod
MYBROWSER_PROFILE=dev
# --- dev 프로필 ---
# 프록시 키와 주소 (주소 필수 — 끝에 /v1 을 붙이지 않는다)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://proxy.example.com
# 프록시 모델 이름 (공급자 접두사 포함, 날짜 접미사 없이 — 목록은 GET {BASE}/v1/models). 없으면 bedrock.anthropic.claude-opus-5-5
MYBROWSER_MODEL=bedrock.anthropic.claude-opus-5-5
# --- prod 프로필 ---
# 게이트웨이 주소 (없으면 빌드 기본값). ANTHROPIC_* · MYBROWSER_MODEL 은 무시한다
# MYBROWSER_GATEWAY_URL=https://gateway.mybrowser.app
# 원격 디버깅 포트 (개발·테스트용, 127.0.0.1 바인딩)
MYBROWSER_CDP_PORT=9222
