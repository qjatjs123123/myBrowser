# 복사해서 .env 로 쓴다. Claude 는 .env 를 읽거나 고칠 수 없다.
ANTHROPIC_API_KEY=
# 개발 전용 모델 프록시 주소 (예: 사내 LiteLLM) — 쓸 때만 주석을 풀고 URL 을 넣는다(빈 값은 시작 실패). 없으면 api.anthropic.com, 설치판은 무시
# ANTHROPIC_BASE_URL=https://proxy.example.com
# 에이전트 모델 (기본 claude-opus-5-5 — 날짜 접미사 없이)
MYBROWSER_MODEL=claude-opus-5-5
# 원격 디버깅 포트 (개발·테스트용, 127.0.0.1 바인딩)
MYBROWSER_CDP_PORT=9222
